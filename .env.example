# Copy this file to .env and fill in the values before running.

# ── MCP server ──────────────────────────────────────────────────────────────
# Bearer token that LLM clients must supply to connect to this MCP server.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=change-me-generate-a-strong-random-token

# Bind address and port (defaults: 0.0.0.0 and 8000)
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# ── Wiki.js connection ───────────────────────────────────────────────────────
# Base URL of your Wiki.js v2 instance (no trailing slash)
WIKIJS_URL=http://localhost:3000

# API key generated in Wiki.js → Administration → API Access
WIKIJS_API_KEY=your-wikijs-api-key-here
